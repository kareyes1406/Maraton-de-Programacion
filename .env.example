# Variables de entorno (copiar a la configuracion del proveedor de nube; NO subir valores reales)

# --- comunes
ENTORNO=produccion                 # desarrollo | produccion (produccion exige HTTPS y secretos por entorno)

# --- auth-service
AUTH_ISSUER=https://maraton-rutas-auth.onrender.com   # opcional en Render (usa RENDER_EXTERNAL_URL)
FRONTEND_URL=https://maraton-rutas-api.onrender.com
AUTH_TOKEN_TTL=900                 # vida del access token en segundos
AUTH_PASSWORD_MEDICO_DEMO=         # >= 12 caracteres
AUTH_PASSWORD_COORDINADOR_DEMO=
AUTH_PASSWORD_AUDITOR_DEMO=
AUTH_SECRET_INTEGRACION_SECRETARIA=
# AUTH_PRIVATE_KEY_PEM=            # opcional: llave RSA fija; si falta se genera al iniciar

# --- rutas-service
AUTH_URL=https://maraton-rutas-auth.onrender.com
# ALLOWED_ORIGINS=                 # origenes extra separados por coma
